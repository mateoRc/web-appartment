{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rabac-appartment",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "rabac.mateolabs.dev", "custom_domain": true }],
  "build": {
    "command": "node build.mjs",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
}
